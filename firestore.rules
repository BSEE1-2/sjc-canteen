rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is a canteen owner
    function isCanteenOwner() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isCanteenOwner();
      allow write: if isOwner(userId);
    }

    // Food items catalog
    match /foodItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isCanteenOwner();
    }

    // Orders collection
    match /orders/{orderId} {
      // Students can read their own orders; owners can read all orders
      allow read: if isAuthenticated() && (
        resource.data.studentUiD == request.auth.uid || isCanteenOwner()
      );
      // Students create orders with their own UID
      allow create: if isAuthenticated() && request.resource.data.studentUiD == request.auth.uid;
      // Owners or students can update status (e.g. owner preparing/done, student cancel)
      allow update: if isCanteenOwner() || (
        isAuthenticated() && resource.data.studentUiD == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status == 'Cancelled'
      );
      allow delete: if isCanteenOwner();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isCanteenOwner();
    }
  }
}
