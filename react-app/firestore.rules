rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isStudent() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        userId == request.auth.uid ||
        isAdmin() ||
        (isOwner() && resource.data.role == 'owner') ||
        (isStudent() && resource.data.role == 'owner' && resource.data.status == 'approved')
      );
      allow create: if signedIn() && request.auth.uid == userId
        && ((request.resource.data.role == 'student' && request.resource.data.status == 'active')
          || (request.resource.data.role == 'owner' && request.resource.data.status == 'pending'));
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && (resource.data.role != 'owner' || request.resource.data.status == resource.data.status)
      );
      allow delete: if isAdmin();
    }

    match /foodItems/{itemId} {
      allow read: if signedIn();
      allow create: if isOwner() && request.resource.data.storeId == request.auth.uid;
      allow update, delete: if isOwner() && resource.data.storeId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (
        resource.data.studentUiD == request.auth.uid ||
        (isOwner() && resource.data.storeId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isStudent() && request.resource.data.studentUiD == request.auth.uid;
      allow update: if (isOwner() && resource.data.storeId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin() ||
        (isStudent() && resource.data.studentUiD == request.auth.uid) ||
        (isOwner() && resource.data.storeId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner();
      allow delete: if false;
    }
  }
}
